# Placeholder only. Put your real key in the local .env file, not in this template.
ELEVENLABS_API_KEY=

# Optional default voice ID, used when no voice is selected. Defaults to George.
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Optional. The default is eleven_v4_turbo. To use Multilingual v2 instead:
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Set on the server only. Required for Gemini cleanup.
GEMINI_API_KEY=

# Optional origin for connecting a browser on another local port.
# SIGNWAVE_FRONTEND_ORIGIN=http://localhost:5173
